{
  "name": "cyberquest_api",
  "version": "1.0.0",
  "description": "Backend API for CyberQuest - kids cybersecurity education app",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "seed": "tsx src/seeders/seed.ts",
    "seed:admin": "tsx src/seeders/seedAdmin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:integration": "jest --runInBand --testPathPattern='integration'",
    "test:unit": "jest --runInBand --testPathPattern='unit'"
  },
  "keywords": [
    "cyberquest",
    "express",
    "sequelize",
    "postgres",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/winston": "^2.4.4",
    "jest": "^29.7.0",
    "jest-environment-node": "^30.4.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "ts-jest": "29",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
